# Dockerfile.tollgate — Builds the TollGate service binary for cloud-lab testing.
#
# The binary runs on x86_64 Linux with a fake ndsctl in PATH instead of
# NoDogSplash. All payment, session, merchant, and mint-health logic runs
# unmodified — only the gate (valve) calls are intercepted.

# Toolchain + version come from the manifest (packaging/build-inputs.json)
# via docker-compose build args exported by lab.sh — the defaults below are
# lockstep fallbacks, drift-gated by tests/contract/check-toolchain-parity.py.
ARG GO_VERSION=1.26.8
FROM golang:${GO_VERSION}-bookworm AS builder

WORKDIR /build

# Copy the entire src/ tree (multi-module project with replace directives)
COPY src/ .

# Build the TollGate service binary (package main in src/)
ARG PACKAGE_VERSION=0.0.0-r0
ARG LDFLAGS=""
# Canonical flags — identical to scripts/build-sdk-package.sh so this
# shortcut path reproduces the SDK path's binary (see repro-check path-parity).
ARG PACKAGE_VERSION=0.0.0-r0
ARG LDFLAGS=""
# Canonical flags — identical to scripts/build-sdk-package.sh so this
# shortcut path reproduces the SDK path's binary (repro-check path-parity).
RUN CGO_ENABLED=0 go build -o /tollgate -trimpath -buildvcs=false -ldflags="$LDFLAGS" .

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl iproute2 socat && \
    rm -rf /var/lib/apt/lists/*

# TollGate service binary
COPY --from=builder /tollgate /usr/local/bin/tollgate

# Fake ndsctl that replaces NoDogSplash
COPY tests/cloud-lab/fake-ndsctl.sh /usr/local/bin/ndsctl
RUN chmod +x /usr/local/bin/ndsctl

# Config files are mounted via docker-compose volumes
# /etc/tollgate/config.json
# /etc/tollgate/identities.json
# /etc/tollgate/install.json

# Create the config directory
RUN mkdir -p /etc/tollgate

EXPOSE 2121

CMD ["tollgate"]

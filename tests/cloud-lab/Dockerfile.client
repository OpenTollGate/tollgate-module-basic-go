# Dockerfile.client — Test runner container for cloud-lab.
#
# Contains cdk-cli (for Cashu wallet operations), nak (for Nostr event
# signing), and Python+pytest (for test execution).

# Declared before the first FROM so the go-builder stage's FROM can
# interpolate it — an ARG declared after a FROM is stage-scoped and
# invisible to every later FROM, which buildkit rejects as the empty
# reference "golang:-bookworm" (#724). This fix landed as #728, was
# regressed by #687's file rewrite, and #716's re-fix closed unmerged —
# every client-container lane (including the crash-injection harness
# this file's killer image builds from) has been unbuildable on main
# since 2026-10-06. Third landing; the hoist is load-bearing.
ARG GO_VERSION=1.26.8

FROM rust:1.88-bookworm AS rust-builder

# Build cdk-cli for wallet operations
RUN cargo install cdk-cli --locked

# Toolchain from the manifest — see Dockerfile.tollgate's header note.
ARG GO_VERSION=1.26.8
FROM golang:${GO_VERSION}-bookworm AS go-builder

# Install nak (Nostr Swiss Army Knife)
RUN go install github.com/fiatjaf/nak@latest

# --- Runtime stage ---
FROM python:3.12-slim-bookworm

# Copy cdk-cli from rust builder
COPY --from=rust-builder /usr/local/cargo/bin/cdk-cli /usr/local/bin/cdk-cli

# Copy nak from go builder
COPY --from=go-builder /go/bin/nak /usr/local/bin/nak

# Install Python test dependencies
RUN pip install --no-cache-dir pytest requests

# Default working directory
WORKDIR /tests

# Install curl for health checks in tests
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

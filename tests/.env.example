# Test Environment Secrets
# Copy this file to .env and fill in your values.
#   cp tests/.env.example tests/.env
#
# tests/.env is gitignored — credentials never leave your machine.
# conftest.py refuses to collect without all four set (#509). If you ran
# the fleet before 2026-09-22, the values that used to live in this file
# and conftest.py were public — rotate them.

# SSH password for router admin access
ROUTER_PASSWORD=change-me

# WiFi SSID to configure on router STA interfaces
WIFI_SSID=change-me

# WiFi passphrase for the target network
WIFI_PASSWORD=change-me

# Blossom URL of the tollgate-wrt .ipk the fleet installs. Use a
# content-addressed (sha-named) artifact path from a kind-1063 event so
# the download is hash-pinned by construction, and verify the file's
# sha256 after download.
BLOSSOM_URL=change-me

# Editor / OS
*.DS_Store
.idea
.roo/

# Merge / patch artifacts
*.orig

# Go build outputs (binaries that land at repo or src/ root).
# Anchored so the bare names cannot shadow source directories such as
# src/cmd/tollgate-cli/ — unanchored, they silently ignore new files there.
# A binary is named after the last element of the module path, so the CLI
# module (src/cmd/tollgate-cli, module `tollgate-cli`) writes its executable
# next to its sources — not at src/tollgate-cli.
bin/
artifacts/
vendor/
/tollgate
/tollgate-wrt
/tollgate-module-basic-go
/tollgate-cli
src/tollgate
src/tollgate-wrt
src/tollgate-module-basic-go
src/cmd/tollgate-cli/tollgate-cli
*.exe

# Test artifacts
**/tollwallet_db/*
tests/*.bin
tests/__pycache__/
tests/.env
# Per-checkout cloud-lab compose project isolation (.env.example is the template)
tests/cloud-lab/.env

# Host-specific cloud-lab port overrides (auto-loaded by docker compose;
# see "Gotchas" in tests/cloud-lab/README.md)
tests/cloud-lab/docker-compose.override.yml

# Router credentials (copy from routers.env.example)
routers.env

# Router mutex (shared lock file at /root/routers.lock)
routers.lock

# AI tooling — shared skills are symlinked, local memory is per-repo
# (AGENTS.md is committed and shared; CLAUDE.md is a local symlink to it)
.claude/
CLAUDE.md
agents/
skills
memory-global
memory-project/
reference/
.opencode/
.omo/

# Planning docs — internal, not for release
docs/tmp/
.omo/
.playwright-mcp/
*-plan.md
PLAN-*.md
TODO-*.md
MOCK-*.md
notepad*.md
handover*.md
ulw-*.md
# Captive portal build output (built from source via packaging/portal-build.sh)
packaging/files/tollgate-captive-portal-site/assets/
nuts/
packaging/*.ipk
scripts/token-recovery/token-recovery
*.cov

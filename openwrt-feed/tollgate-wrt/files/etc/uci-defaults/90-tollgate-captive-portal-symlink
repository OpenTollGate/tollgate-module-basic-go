#!/bin/sh

# TollGate Captive Portal Stub
#
# nodogsplash's pre-auth path (libmicrohttpd) is fragile when serving a
# full SPA: if NDS cannot resolve the client MAC (`ip neigh` miss) or
# hits an internal error, every request — including / — is answered
# with an NDS error page rendered as HTTP 500. NDS also hardcodes
# splash.html as its DEFAULT_SPLASHPAGE — every pre-auth client is
# redirected to /splash.html — so the stub is installed under exactly
# that name. htdocs must NOT be a symlink to the SPA at
# /etc/tollgate/tollgate-captive-portal-site; it now holds a tiny stub
# page that bounces the client to the SPA served by the dedicated
# uhttpd "portal" instance on port 2051 (created in 99-tollgate-setup,
# pre-auth allowed via nodogsplash users_to_router).
#
# Routers upgraded from the old symlink scheme have htdocs as a symlink;
# it is removed and replaced by a real directory containing the stub.

HTDOCS_DIR="/etc/nodogsplash/htdocs"
STUB_FILE="$HTDOCS_DIR/splash.html"
STUB_TMP="/tmp/tollgate-portal-stub.html"

echo "Setting up TollGate NoDogSplash portal stub..."

# Legacy migration: htdocs is a symlink to the SPA (old scheme, which
# coupled portal availability to NDS's SPA serving). Remove it so the
# stub lands in a real directory instead of through the link into the SPA.
if [ -L "$HTDOCS_DIR" ]; then
    echo "Removing legacy symlink at $HTDOCS_DIR"
    rm -f "$HTDOCS_DIR"
fi

# Fresh install: nodogsplash's stock htdocs (splash.html etc.) may still
# be present with no stub yet — set it aside, mirroring the old
# migration, so the pre-auth portal serves exactly one page: our
# redirect stub. If the stock dir already contains a splash.html it is
# simply overwritten with the stub below; either way the end state is
# always htdocs/splash.html = our redirect stub.
if [ -d "$HTDOCS_DIR" ] && [ ! -f "$STUB_FILE" ] && [ -n "$(ls -A "$HTDOCS_DIR" 2>/dev/null)" ]; then
    echo "Backing up stock $HTDOCS_DIR to ${HTDOCS_DIR}.backup"
    rm -rf "${HTDOCS_DIR}.backup"
    mv "$HTDOCS_DIR" "${HTDOCS_DIR}.backup"
fi

# htdocs existing as a regular file (neither dir nor symlink) would make
# mkdir -p fail and silently wedge the script — remove it so the stub
# still lands.
if [ -e "$HTDOCS_DIR" ] && [ ! -d "$HTDOCS_DIR" ] && [ ! -L "$HTDOCS_DIR" ]; then
    echo "Removing regular file at $HTDOCS_DIR (expected a directory)"
    rm -f "$HTDOCS_DIR"
fi

mkdir -p "$HTDOCS_DIR"

# The <noscript> fallback cannot use JS's location.hostname, and NDS
# redirects pre-auth clients by gateway IP (the OpenWrt NDS init script
# never forwards gatewaydomainname), so embed the actual LAN IP at
# install time.
LAN_IP=$(uci -q get network.lan.ipaddr || echo 192.168.1.1)

# UCI accepts CIDR notation ('192.168.1.1/24') since OpenWrt 21.02; the
# raw value would leak the suffix into the <noscript> fallback URL
# (http://192.168.1.1/24:2051/...). The JS redirect is unaffected — it
# uses location.hostname.
LAN_IP="${LAN_IP%%/*}"

cat > "$STUB_TMP" << EOF
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>TollGate Portal</title>
</head>
<body>
<p>Redirecting to the TollGate portal...</p>
<script>
location.replace('http://' + location.hostname + ':2051/splash.html' + location.search);
</script>
<noscript>
<p><a href="http://${LAN_IP}:2051/splash.html">Continue to the TollGate portal</a></p>
</noscript>
</body>
</html>
EOF

# Idempotent: only (re)write the stub when it is missing or its content
# differs, so repeated runs (postinst + uci-defaults at boot) never
# clobber an already-identical stub.
if [ ! -f "$STUB_FILE" ] || ! cmp -s "$STUB_TMP" "$STUB_FILE"; then
    echo "Installing portal redirect stub at $STUB_FILE"
    cat "$STUB_TMP" > "$STUB_FILE"
else
    echo "Portal redirect stub already present at $STUB_FILE"
fi
rm -f "$STUB_TMP"

# No service restart here: uci-defaults runs before procd starts services,
# so nodogsplash will pick up the stub on its first start.
echo "TollGate NoDogSplash portal stub setup completed"

exit 0

#!/usr/bin/env bash
# Pre-commit hook: run the fences in fences.d/, one file per fence, in
# lexical (numeric-prefix) order.
#
# This dispatcher is STABLE — do not add a fence here. A fence is a file:
# fences.d/NN-<slug>.sh, a complete `if <staged-trigger>; then <check>; fi`
# block (#920). Lanes add files; nobody edits shared bytes, so two lanes
# can never conflict on the hook again.
#
# The disease this cures, with the receipt: every fence-adding lane used to
# concatenate into this one script, and a merge on main ate an entire `fi`
# between the gonuts-pin and build-surface fences (found 2026-10-14 —
# `bash -n hooks/pre-commit` failed on main with "unexpected end of file"),
# so every commit through the hook was refused since.
#
# Install with: git config core.hooksPath hooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Each fragment is parsed STANDALONE before it can run: a fence file that
# bash cannot read is refused here, at the commit that added it, instead of
# wedging every later commit that triggers it.
shopt -s nullglob
fences=(fences.d/*.sh)
if [ "${#fences[@]}" -eq 0 ]; then
    echo "hooks/pre-commit: fences.d/ carries no fences — lost the directory?" >&2
    exit 1
fi
for fence in "${fences[@]}"; do
    if ! bash -n "$fence"; then
        echo "❌ $fence does not parse on its own (bash -n). Every fence is a" >&2
        echo "   complete if/fi block — see fences.d/README.md." >&2
        exit 1
    fi
done

for fence in "${fences[@]}"; do
    bash "$fence"
done

#!/usr/bin/env bash
# Pre-commit hook: check dependency sync + stale import paths.
# Install with: git config core.hooksPath hooks
set -euo pipefail

if git diff --cached --name-only | grep -q '\.mod$\|go\.sum$'; then
    echo "🔍 Checking dependency sync across go.mod files..."
    python3 tests/contract/check-deps-sync.py
fi

if git diff --cached --name-only | grep -q '\.go$'; then
    echo "🔍 Checking for stale import paths..."
    python3 tests/contract/check-import-paths.py
fi

# Check gofmt on staged Go files
if git diff --cached --name-only | grep -q '\.go$'; then
    unformatted=$(gofmt -l $(git diff --cached --name-only -- '*.go'))
    if [ -n "$unformatted" ]; then
        echo "❌ gofmt found unformatted files:"
        echo "$unformatted"
        echo ""
        echo "Run: gofmt -w <files>"
        exit 1
    fi
fi

#!/usr/bin/env bash
# Pre-commit hook: check dependency sync + stale import paths.
# Install with: git config core.hooksPath hooks
set -euo pipefail

if git diff --cached --name-only | grep -q '\.mod$\|go\.sum$'; then
    echo "🔍 Checking dependency sync across go.mod files..."
    python3 tests/contract/check-deps-sync.py
fi

if git diff --cached --name-only | grep -q '\.go$'; then
    echo "🔍 Checking for stale import paths..."
    python3 tests/contract/check-import-paths.py
fi

# Single source of truth for the release version (VERSION at the repo root).
# Only runs when a file that carries the version is staged.
if git diff --cached --name-only \
    | grep -qE '^VERSION$|^src/cli/version\.go$|^packaging/local-build-ipk\.sh$|^packaging/Makefile$|^packaging/files/etc/uci-defaults/99-tollgate-setup$'; then
    echo "🔍 Checking release-version consistency..."
    sh scripts/check-version-sync.sh
fi

# Check gofmt on staged Go files (--diff-filter=d: gofmt cannot read
# deleted files; xargs -I{} keeps one file per line, spaces-safe)
if git diff --cached --name-only | grep -q '\.go$'; then
    unformatted=$(git diff --cached --name-only --diff-filter=d -- '*.go' | xargs -I{} gofmt -l -- {})
    if [ -n "$unformatted" ]; then
        echo "❌ gofmt found unformatted files:"
        echo "$unformatted"
        echo ""
        echo "Run: gofmt -w <files>"
        exit 1
    fi
fi

# The open AP's SSID is written into the beacon of every router that takes the
# default, and it is the name clients and the operator match on — keep it the
# contract shape (`<brand>-<4 hex chars>`) so a band suffix or a fixed literal
# cannot come back. Runs whenever anything under packaging/files/ is staged:
# that tree is what the .ipk/.apk payload is staged from.
if git diff --cached --name-only | grep -qE '^packaging/files/'; then
    echo "🔍 Checking the AP SSID format contract..."
    bash tests/contract/check-ssid-format.sh
fi

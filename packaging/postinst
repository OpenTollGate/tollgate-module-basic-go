#!/bin/sh

echo "Running post-installation script: Starting postinst execution"
echo "Current working directory: $(pwd)"
echo "Current timestamp: $(date)"

wait_for_iface() {
    local iface="$1" count=0
    while [ $count -lt 15 ]; do
        [ -d "/sys/class/net/$iface" ] && return 0
        sleep 1
        count=$((count + 1))
    done
    echo "Warning: $iface did not appear within 15 s" >&2
    return 1
}

# The credential-creating script runs BEFORE the fail-closed admin gate, which
# runs LAST: the gate drops the board's listeners while root has no credential,
# and 99-tollgate-setup is what creates one. Numeric order 90, 92, 99 put the gate
# first and killed the board on a fresh hand-install.
for script in /etc/uci-defaults/90-tollgate-captive-portal-symlink \
              /etc/uci-defaults/99-tollgate-setup \
              /etc/uci-defaults/999-tollgate-admin-setup; do
    if [ -x "$script" ]; then
        echo "Running $script ..."
        "$script" || echo "Warning: $script exited with code $?"
    fi
done

# IPv6 is disabled at INSTALL time, before the network restart below applies
# it — the marker-driven setup driver may take a verify/repair path whose
# policy list predates this rule, but the pre-auth bypass (#783) must close
# the moment the package lands, not at the next full-setup pass (#148/#783).
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set network.lan.ip6assign='0'
uci set network.lan.ipv6='0'
if uci -q get network.wan >/dev/null 2>&1; then
    uci set network.wan.ipv6='0'
fi
if uci -q get network.wan6 >/dev/null 2>&1; then
    uci set network.wan6.disabled='1'
fi
uci commit dhcp 2>/dev/null || true
uci commit network 2>/dev/null || true
echo "IPv6 disabled globally at install time (captive-portal bypass prevention, #148/#783)"

echo "Restarting network..."
# A full netifd restart re-applies UCI-backed routes only. Default routes that
# were added by hand (statically-routed bench/CI seats: no DHCP WAN, no uci
# gateway) are silently wiped, which kills egress right after the install.
# Snapshot them here; restore_default_routes (below) re-adds whatever the
# restart did not bring back. Pinned by tests/packaging/postinst-default-route-preserve_test.sh.
_pre_restart_defroutes="$(ip route show default 2>/dev/null)"
restore_default_routes() {
    [ -n "$1" ] || return 0
    echo "$1" | while IFS= read -r route; do
        [ -n "$route" ] || continue
        ip route show default 2>/dev/null | grep -qxF "$route" || \
            ip route add $route 2>/dev/null || true
    done
}
/etc/init.d/network restart 2>/dev/null || true
wait_for_iface br-lan
wait_for_iface br-private || echo "Note: br-private not found — this is expected on devices without a private network configured."

# The uplink lease can arrive only AFTER the restart above, so the private subnet
# chosen at uci-defaults time may now collide with the upstream — a router that
# came up with 192.168.1.0/24 on both sides has no working private network. The
# feed recipe (packaging/Makefile) has carried this recheck, and its second
# restart, since #926; this standalone recipe did not, so a seat installed from
# it kept a colliding private subnet. Keep the two recipes structurally equal:
# this is the same second restart the restore below must sit after.
if [ -x /etc/uci-defaults/99-tollgate-setup ]; then
    ( TOLLGATE_SETUP_LIB_ONLY=1 . /etc/uci-defaults/99-tollgate-setup 2>/dev/null
      recheck_private_subnet && /etc/init.d/network restart 2>/dev/null || true
    )
fi

restore_default_routes "$_pre_restart_defroutes"

echo "Reloading remaining services..."
wifi reload 2>/dev/null || true
/etc/init.d/firewall reload 2>/dev/null || true
/etc/init.d/dnsmasq restart 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true
# Fail loud when the captive portal cannot serve: an aborted opkg
# transaction can orphan-remove runtime deps and leave zero-byte husks
# (nodogsplash binary/init — issue #109, the #93 class). Installing
# "successfully" with a dead portal hides the damage until every
# downstream test fails opaquely.
if [ ! -s /usr/bin/nodogsplash ] || [ ! -s /etc/init.d/nodogsplash ]; then
    echo "ERROR: nodogsplash binary or init script is empty (zero bytes) —" >&2
    echo "the install transaction likely aborted and orphan-removed runtime" >&2
    echo "deps. Run 'opkg update' and reinstall nodogsplash, then reinstall" >&2
    echo "this package. Refusing to claim success with a dead portal." >&2
    exit 1
fi
/etc/init.d/nodogsplash restart 2>/dev/null || true

if [ -x /etc/init.d/tollgate-wrt ]; then
    /etc/init.d/tollgate-wrt enable 2>/dev/null || true
    /etc/init.d/tollgate-wrt stop 2>/dev/null || true
    /etc/init.d/tollgate-wrt start 2>/dev/null || true
else
    echo "Warning: /etc/init.d/tollgate-wrt not found, skipping service start"
fi

echo "Post-installation script completed successfully"
exit 0

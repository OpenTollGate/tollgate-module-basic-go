#!/bin/sh

echo "Running post-installation script: Starting postinst execution"
echo "Current working directory: $(pwd)"
echo "Current timestamp: $(date)"

wait_for_iface() {
    local iface="$1" count=0
    while [ $count -lt 15 ]; do
        [ -d "/sys/class/net/$iface" ] && return 0
        sleep 1
        count=$((count + 1))
    done
    echo "Warning: $iface did not appear within 15 s" >&2
    return 1
}

# The credential-creating script runs BEFORE the fail-closed admin gate, which
# runs LAST: the gate drops the board's listeners while root has no credential,
# and 99-tollgate-setup is what creates one. Numeric order 90, 92, 99 put the gate
# first and killed the board on a fresh hand-install.
for script in /etc/uci-defaults/90-tollgate-captive-portal-symlink \
              /etc/uci-defaults/99-tollgate-setup \
              /etc/uci-defaults/999-tollgate-admin-setup; do
    if [ -x "$script" ]; then
        echo "Running $script ..."
        "$script" || echo "Warning: $script exited with code $?"
    fi
done

# IPv6 is disabled at INSTALL time, before the network restart below applies
# it — the marker-driven setup driver may take a verify/repair path whose
# policy list predates this rule, but the pre-auth bypass (#783) must close
# the moment the package lands, not at the next full-setup pass (#148/#783).
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set network.lan.ip6assign='0'
uci set network.lan.ipv6='0'
if uci -q get network.wan >/dev/null 2>&1; then
    uci set network.wan.ipv6='0'
fi
if uci -q get network.wan6 >/dev/null 2>&1; then
    uci set network.wan6.disabled='1'
fi
uci commit dhcp 2>/dev/null || true
uci commit network 2>/dev/null || true
echo "IPv6 disabled globally at install time (captive-portal bypass prevention, #148/#783)"

echo "Restarting network..."
/etc/init.d/network restart 2>/dev/null || true
wait_for_iface br-lan
wait_for_iface br-private || echo "Note: br-private not found — this is expected on devices without a private network configured."

echo "Reloading remaining services..."
wifi reload 2>/dev/null || true
/etc/init.d/firewall reload 2>/dev/null || true
/etc/init.d/dnsmasq restart 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true
/etc/init.d/nodogsplash restart 2>/dev/null || true

if [ -x /etc/init.d/tollgate-wrt ]; then
    /etc/init.d/tollgate-wrt enable 2>/dev/null || true
    /etc/init.d/tollgate-wrt stop 2>/dev/null || true
    /etc/init.d/tollgate-wrt start 2>/dev/null || true
else
    echo "Warning: /etc/init.d/tollgate-wrt not found, skipping service start"
fi

echo "Post-installation script completed successfully"
exit 0

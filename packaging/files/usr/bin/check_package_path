#!/bin/sh
# Apply a pending self-update: install the package staged at the path recorded
# in /etc/tollgate/install.json ("package_path"), then reset the field.
#
# install.json is written exclusively by tollgate-wrt (Go, MarshalIndent,
# stable field order) — a targeted sed on the single "package_path" string
# field is safe and needs no jq on board (minimal installs ship without it).
#
# Field semantics: the Go default is the string "false" (no pending update).

config_path="/etc/tollgate/install.json"
update_path=$(sed -n 's/.*"package_path": *"\([^"]*\)".*/\1/p' "$config_path" 2>/dev/null)

if [ -n "$update_path" ] && [ "$update_path" != "false" ] && [ -f "$update_path" ]; then
	if command -v apk >/dev/null 2>&1; then
		apk add --allow-untrusted "$update_path"
		rc=$?
	elif command -v opkg >/dev/null 2>&1; then
		opkg install "$update_path"
		rc=$?
	else
		echo "No supported package manager found" >&2
		exit 1
	fi

	if [ "$rc" -eq 0 ]; then
		sed 's/\("package_path": *"\)[^"]*"/\1false"/' "$config_path" > /tmp/install.json.tmp \
			&& mv /tmp/install.json.tmp "$config_path"
	fi
fi

#!/bin/sh
# tollgate-nft-interfaces-render — derive the nftables guards' interface
# names from the router's own config instead of compile-time literals (#757).
#
# Why this exists: the shipped /etc/nftables.d guards (20/30/31/32) matched
# the captive bridge by the literal "br-lan". An operator who renames the
# bridge (uci set network.@device[0].name='br-portal') gets a silent
# blackhole: the guards still drop everything not from "br-lan", the portal
# SPA cannot reach :2121, payments never arrive, and logread says nothing
# (bench-verified on rc1: the guard's own drop counter doing the killing).
#
# The guards now reference $tg_portal_if / $tg_private_if — nft defines that
# fw4 resolves when it assembles its ruleset from /etc/nftables.d/*.nft in
# lexical order. This renderer writes 00-tollgate-defs.nft, which sorts
# before every guard and is the ONE place the names live:
#
#   tg_portal_if  — nodogsplash's gatewayinterface (the captive bridge the
#                   portal serves), defaulting to the shipped br-lan
#   tg_private_if — the module-owned private bridge (br-private, the name
#                   99-tollgate-setup itself creates and asserts)
#
# A static default 00-defs (br-lan/br-private) ships with the package, so
# the defines resolve even before the first render — an unresolved define
# would fail the whole fw4 ruleset load, which is the failure mode this
# design exists to make impossible.
#
# Runs from 99-tollgate-setup (install/upgrade/boot) and the tollgate-wrt
# reload trigger (nodogsplash config commits). Pass --reload to re-render
# and reload the firewall when the definitions changed.

DEFS="${TOLLGATE_NFT_DEFS_FRAG:-/etc/nftables.d/00-tollgate-defs.nft}"

say() {
    echo "tollgate-nft-interfaces-render: $*" >&2
    command -v logger >/dev/null 2>&1 && logger -t tollgate-nft-defs "$*" 2>/dev/null
}

valid_ifname() {
    # Interface names: [A-Za-z0-9._-], non-empty. The complement class is
    # the portable busybox-sh way to say "nothing else".
    case "$1" in
        ""|*[!A-Za-z0-9._-]*) return 1 ;;
        *)                    return 0 ;;
    esac
}

render() {
    portal="$(uci -q get nodogsplash.@nodogsplash[0].gatewayinterface 2>/dev/null || true)"
    if [ -z "$portal" ]; then
        portal="br-lan"
        say "nodogsplash gatewayinterface unset — defaulting tg_portal_if to br-lan"
    elif ! valid_ifname "$portal"; then
        portal="br-lan"
        say "nodogsplash gatewayinterface is not a usable interface name — refusing it and defaulting tg_portal_if to br-lan"
    fi

    private="$(uci -q get network.private_bridge.name 2>/dev/null || true)"
    if [ -z "$private" ]; then
        private="br-private"
        say "network.private_bridge.name unset — defaulting tg_private_if to br-private"
    elif ! valid_ifname "$private"; then
        private="br-private"
        say "network.private_bridge.name is not a usable interface name — refusing it and defaulting tg_private_if to br-private"
    fi

    tmp="$(mktemp "${DEFS}.XXXXXX")" || {
        say "cannot create temp file for $DEFS"
        return 1
    }

    {
        echo "# Generated by tollgate-nft-interfaces-render — do not edit."
        echo "# The interface defines every /etc/nftables.d guard resolves"
        echo "# (\$tg_portal_if = nodogsplash's gatewayinterface, \$tg_private_if = the"
        echo "# module-owned private bridge). This file sorts first, so the defines"
        echo "# exist before any guard references them (#757: the guards used to"
        echo "# hardcode br-lan and silently blackholed a renamed captive bridge)."
        echo "# A shipped static default carries the br-lan/br-private names, so the"
        echo "# defines resolve even before the first render."
        echo "define tg_portal_if = \"$portal\""
        echo "define tg_private_if = \"$private\""
    } > "$tmp" || { rm -f "$tmp"; say "cannot write $DEFS"; return 1; }

    if [ -f "$DEFS" ] && cmp -s "$tmp" "$DEFS"; then
        rm -f "$tmp"
        echo "unchanged"
        return 0
    fi
    mv "$tmp" "$DEFS" || { rm -f "$tmp"; say "cannot move definitions into place: $DEFS"; return 1; }
    echo "rendered"
}

case "${1:-}" in
    --reload)
        out="$(render)" || exit 1
        if [ "$out" = "rendered" ]; then
            fw4 reload >/dev/null 2>&1 || {
                say "definitions updated but 'fw4 reload' failed — run it by hand: $DEFS"
                exit 1
            }
            say "interface definitions rendered and firewall reloaded: $DEFS"
        else
            say "interface definitions unchanged: $DEFS"
        fi
        ;;
    "")
        render || exit 1
        ;;
    *)
        echo "usage: $0 [--reload]" >&2
        exit 2
        ;;
esac

# This file is used to preserve configuration during sysupgrade
/etc/config/network
/etc/config/wireless
# The one-device-code store (`config device 'device'` -> option code/nym):
# an upgrade must keep the code, or the next boot mints a different one.
# The module's own uci namespace: the wired LAN port's role
# (tollgate.lan_ports.role) is an operator choice, so an upgrade must not
# silently reset the cable to another bridge.
/etc/config/tollgate
/etc/tollgate
